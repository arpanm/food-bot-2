{
  "manifest_version": 3,
  "name": "Food Bot Workflow Executor",
  "version": "1.0.0",
  "description": "Browser-based workflow executor - polls workflow JSON and executes client-side",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://localhost:*/*", "https://*/*"],
  "background": {
    "service_worker": "dist/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ]
}
