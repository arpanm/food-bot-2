# =============================================================================
# Food Bot 2 - Environment Template
# Copy to .env and fill in values
# =============================================================================

# -----------------------------------------------------------------------------
# LLM Configuration (on/off and API keys)
# -----------------------------------------------------------------------------
CLAUDE_ENABLED=true
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514

OPENAI_ENABLED=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

GEMINI_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# -----------------------------------------------------------------------------
# MCP Layer (enable/disable, mock mode for testing)
# -----------------------------------------------------------------------------
MCP_INTERNAL_ENABLED=true
MCP_INTERNAL_URL=http://localhost:3100

MCP_SWIGGY_ENABLED=false
MCP_SWIGGY_URL=https://mcp.swiggy.com/food
MCP_SWIGGY_MOCK=true

MCP_ZOMATO_ENABLED=false
MCP_ZOMATO_URL=https://mcp-server.zomato.com/mcp
MCP_ZOMATO_MOCK=true

MCP_ONDC_ENABLED=false
MCP_ONDC_URL=http://localhost:3200
MCP_ONDC_MOCK=true

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=foodbot
POSTGRES_PASSWORD=changeme
POSTGRES_DB=foodbot

REDIS_URL=redis://localhost:6379

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

ELASTICSEARCH_NODE=http://localhost:9200

# -----------------------------------------------------------------------------
# Kafka
# -----------------------------------------------------------------------------
KAFKA_BROKERS=localhost:9092

# -----------------------------------------------------------------------------
# Temporal
# -----------------------------------------------------------------------------
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=food-bot-workflows

# -----------------------------------------------------------------------------
# API Gateway / Auth
# -----------------------------------------------------------------------------
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
API_GATEWAY_PORT=3000

# -----------------------------------------------------------------------------
# Service URLs (for inter-service calls)
# -----------------------------------------------------------------------------
CUSTOMER_SERVICE_URL=http://localhost:3001
RESTAURANT_SERVICE_URL=http://localhost:3002
ORDER_SERVICE_URL=http://localhost:3003
WORKFLOW_SERVICE_URL=http://localhost:3004
SEARCH_SERVICE_URL=http://localhost:3005
LLM_SERVICE_URL=http://localhost:3006
MCP_SERVICE_URL=http://localhost:3007
PERSONALIZATION_SERVICE_URL=http://localhost:3008

# -----------------------------------------------------------------------------
# Claude Code Multi-Agent (for orchestration)
# -----------------------------------------------------------------------------
CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1
